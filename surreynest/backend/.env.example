# SurreyNest Backend — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to git

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://surreynest:your_password_here@localhost:5432/surreynest
# Separate DB for pytest — never runs against dev/prod data
TEST_DATABASE_URL=postgresql://surreynest:your_password_here@localhost:5432/surreynest_test

# ─── App ─────────────────────────────────────────────────────────────────────
# Options: development | production
ENVIRONMENT=development

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# Internal-only access key for moderation and pipeline control endpoints
INTERNAL_ADMIN_KEY=REPLACE_WITH_A_STRONG_RANDOM_VALUE

# ─── ML Model ────────────────────────────────────────────────────────────────
ML_MODEL_VERSION=v1.0.0
ML_MODEL_PATH=app/ml/models

# ─── Email (for pipeline failure alerts — optional for MVP) ──────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your_app_password
# ALERT_EMAIL=your@gmail.com

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Max requests per minute per IP for search endpoints
RATE_LIMIT_SEARCH=60
# Max review submissions per hour per IP
RATE_LIMIT_REVIEWS=5
