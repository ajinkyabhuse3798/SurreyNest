# SurreyNest Backend — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to git

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://surreynest:your_password_here@localhost:5432/surreynest

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30

# ─── App ─────────────────────────────────────────────────────────────────────
# Options: development | production
ENVIRONMENT=development

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# ─── ML Model ────────────────────────────────────────────────────────────────
ML_MODEL_VERSION=v1.0.0
ML_MODEL_PATH=app/ml/models

# ─── Email (for pipeline failure alerts — optional for MVP) ──────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your_app_password
# ALERT_EMAIL=your@gmail.com

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Max requests per minute per IP for search endpoints
RATE_LIMIT_SEARCH=60
# Max review submissions per hour per user
RATE_LIMIT_REVIEWS=5
