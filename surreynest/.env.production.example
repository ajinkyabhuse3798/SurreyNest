# SurreyNest production environment
# Copy this file to .env.production before deploying.

# Required infrastructure secrets
POSTGRES_PASSWORD=replace_with_a_strong_database_password
REDIS_PASSWORD=replace_with_a_strong_redis_password
SECRET_KEY=replace_with_a_64_char_hex_secret
INTERNAL_ADMIN_KEY=replace_with_a_separate_internal_ops_secret

# Public app URLs
# Use your free hosting subdomain or public server IP if you do not own a custom domain yet.
ALLOWED_ORIGINS=http://YOUR_SERVER_IP
FRONTEND_URL=http://YOUR_SERVER_IP

# Frontend build config
# Leave blank to use same-origin /api via the frontend Nginx proxy.
VITE_API_URL=
VITE_CLOUDFLARE_ANALYTICS_TOKEN=

# Backend runtime config
ENVIRONMENT=production
ML_MODEL_VERSION=v8.0.0
ML_MODEL_PATH=app/ml/models

# Optional EPC pipeline credentials
EPC_API_USERNAME=
EPC_API_KEY=

# Optional SMTP credentials
# If omitted, new accounts are auto-verified and password reset is disabled
# instead of showing a broken email flow.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SurreyNest <noreply@surreynest.com>"
